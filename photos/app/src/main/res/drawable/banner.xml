<?xml version="1.0" encoding="utf-8"?>
<!-- 16:9 tile, in the style of Smart Home's: a warm gradient with the photo icon in the middle (insets, as item
     width/height are ignored on the TV's Android 11). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <gradient android:angle="315" android:startColor="#FFF29B38" android:endColor="#FFB0306A" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_photos" android:left="112dp" android:right="112dp" android:top="42dp" android:bottom="42dp" />
</layer-list>
