<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmartHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:colorAccent">#FF4CD08A</item>
        <item name="android:alertDialogTheme">@style/Dialog</item>
    </style>
    <style name="Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#FF4CD08A</item>
        <item name="android:windowBackground">@drawable/glass_panel</item>
    </style>
    <!-- Frosted pill, focus turns it white (pill_bg / pill_text, as on the clean launcher). -->
    <style name="Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textColor">@drawable/pill_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
